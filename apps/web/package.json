{
  "name": "ladies-only-events-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"tailwindcss --config ./tailwind.config.ts --input ./app/globals.css --output ./app/tailwind.generated.css --watch\" \"next dev\"",
    "build": "tailwindcss --config ./tailwind.config.ts --input ./app/globals.css --output ./app/tailwind.generated.css --minify && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
